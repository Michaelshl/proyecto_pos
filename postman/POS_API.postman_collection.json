            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"P777\",\n  \"nombre\": \"x\",\n  \"precioVenta\": 1,\n  \"stockInicial\": 1,\n  \"stockMinimo\": 1,\n  \"categoria\": \"Bebidas\"\n}" }
          }
        },
        {
          "name": "Cajero consulta stock -> 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCajero}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/productos/P001/stock"
          }
        },
        {
          "name": "Cajero ajusta stock -> 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCajero}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/productos/P001/ajustes",
            "body": { "mode": "raw", "raw": "{\n  \"cantidad\": 5,\n  \"motivo\": \"x\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Logout y revocación de token (RF-002)",
      "item": [
        {
          "name": "Login (token temporal)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenTemp', pm.response.json().token);"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"cedula\": \"{{adminCedula}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          }
        },
        {
          "name": "Logout -> 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTemp}}", "type": "string" }] },
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Usar el token ya cerrado -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401: el token quedó revocado', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTemp}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/categorias"
          }
        },
        {
          "name": "Logout sin token -> 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    }
  ]
