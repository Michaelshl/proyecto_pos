# Copiar este archivo como .env y completar los valores. .env NO se sube a Git.
# También sirven como variables de entorno del sistema o de la configuración de ejecución del IDE.

# Obligatorias
DB_PASSWORD=cambiar_por_la_contraseña_de_mysql
JWT_SECRET=cambiar_por_una_clave_aleatoria_de_minimo_32_caracteres

# Opcionales (valores por defecto)
# DB_URL=jdbc:mysql://localhost:3306/pos_db
# DB_USER=root
